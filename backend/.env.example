APP_DATABASE_URL=sqlite:///./contabilidadv2.db

# Generar clave segura con: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=generar-clave-criptograficamente-segura-de-al-menos-32-caracteres
